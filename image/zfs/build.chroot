#!/bin/sh
# Installing the packages may have built the modules already, or not: that depends on their order.
set -eu
kernel=$(ls /usr/lib/modules)
version=$(dpkg-query -W -f '${source:Upstream-Version}' zfs-dkms)
dkms status "zfs/$version" -k "$kernel" | grep -q ': installed' ||
  dkms install "zfs/$version" -k "$kernel" --no-depmod || { cat "/var/lib/dkms/zfs/$version/build/make.log"; exit 1; }
