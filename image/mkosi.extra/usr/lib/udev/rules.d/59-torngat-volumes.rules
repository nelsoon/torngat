# Decrypted volumes of instances, torngat-vol-<uid>: what is in them is the tenant's. After 55-dm.rules
# (which names them) and before 60-persistent-storage-dm.rules: nothing on the host probes them,
# links them by label or uuid, activates or assembles anything found in them.
SUBSYSTEM!="block", GOTO="torngat_volumes_end"
KERNEL!="dm-[0-9]*", GOTO="torngat_volumes_end"
ACTION=="remove", GOTO="torngat_volumes_end"
ENV{DM_NAME}!="torngat-vol-*", GOTO="torngat_volumes_end"
ENV{DM_UDEV_DISABLE_DISK_RULES_FLAG}="1"
ENV{DM_UDEV_DISABLE_OTHER_RULES_FLAG}="1"
ENV{UDEV_DISABLE_PERSISTENT_STORAGE_BLKID_FLAG}="1"
OPTIONS:="nowatch"
LABEL="torngat_volumes_end"
