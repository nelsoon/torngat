#!/bin/sh
# Adds the image's certificate to this machine's Secure Boot keys. The firmware must be in Setup Mode
# (no platform key). Existing db and KEK entries are kept: option ROMs of network cards and GPUs are
# usually signed with them.
#
#   torngat-enroll-secure-boot [--allow-no-vendor-keys]
#
# The encrypted root is made anew at the next boot, as its key was not protected by Secure Boot so far:
# everything on it is lost. It refuses on a node that is already set up.
#
# --allow-no-vendor-keys accepts a firmware without any existing db entry (refused by default, as
# hardware that needs vendor-signed option ROMs may then not start).
set -eu
keys=/usr/lib/torngat/secure-boot
vars=/sys/firmware/efi/efivars
global=8be4df61-93ca-11d2-aa0d-00e098032b8c
security=d719b2cb-3d3a-4596-a3bc-dad00e67656f
die() { echo "torngat-enroll-secure-boot: $*" >&2; exit 1; }

force=
case "$*" in
  --allow-no-vendor-keys) force=1 ;;
  '') ;;
  *) die "usage: torngat-enroll-secure-boot [--allow-no-vendor-keys]" ;;
esac
[ "$(id -u)" = 0 ] || die "run as root"
[ -d "$vars" ] || die "this machine was not booted with UEFI"
for f in PK KEK db; do [ -s "$keys/$f.auth" ] || die "$keys/$f.auth is missing"; done

[ ! -e /var/lib/torngat/node.json ] ||
  die "this node is already set up, and enrolling makes its root file system anew: reinstall it instead"

byte() { od -An -tu1 -j4 -N1 "$vars/$1-$global" 2>/dev/null | tr -d ' '; }
[ "$(byte SetupMode)" = 1 ] ||
  die "the firmware is not in Setup Mode: clear the platform key in the firmware setup first"

size() { if [ -e "$1" ]; then stat -c %s "$1"; else echo 0; fi; }
# 4 bytes are the variable's attributes.
if [ "$(size "$vars/db-$security")" -le 4 ] && [ -z "$force" ]; then
  die "the firmware has no db entries to keep: restore its factory keys (and clear only the platform key), or use --allow-no-vendor-keys"
fi

if [ "$(size "$vars/dbx-$security")" -le 4 ]; then
  echo "warning: the firmware has no revocation list (dbx): boot loaders known to be vulnerable are trusted" >&2
fi

# Attributes (little endian): non-volatile, boot and runtime access, time-based authentication, and
# for db and KEK append. The kernel needs everything in a single write.
put() { # ATTRIBUTES FILE VARIABLE
  if [ -e "$3" ]; then chattr -i "$3"; fi
  # shellcheck disable=SC2059
  { printf "$1\\000\\000\\000"; cat "$2"; } >"$tmp"
  dd if="$tmp" of="$3" bs=64k conv=notrunc status=none || die "the firmware refused $2"
}
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
# First, so that Secure Boot is never on with the old root. systemd-repart acts on it in the initrd, and
# removes it. The value is UTF-16.
reset=$vars/FactoryReset-8cf2644b-4b0b-428f-9387-6d876050dc67
if [ -e "$reset" ]; then chattr -i "$reset"; fi
printf '\007\000\000\000y\000e\000s\000\000\000' >"$tmp"
dd if="$tmp" of="$reset" bs=64k status=none || die "the firmware refused the factory reset request"
append='\147' # 0x67
replace='\047' # 0x27
put "$append" "$keys/db.auth" "$vars/db-$security"
put "$append" "$keys/KEK.auth" "$vars/KEK-$global"
# Last: it ends Setup Mode.
put "$replace" "$keys/PK.auth" "$vars/PK-$global"
[ "$(byte SetupMode)" = 0 ] || die "the firmware is still in Setup Mode"
echo "Keys enrolled. Reboot, and turn Secure Boot on in the firmware setup if it is not on by itself. The root file system is made anew."
