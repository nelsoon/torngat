# The TPM unlocks the root; if it refuses, the recovery key is asked for on the console. The device
# appears once make-root has made it, which can take a while on a large or slow disk.
root /dev/gpt-auto-root-luks - luks,discard,tpm2-device=auto,tpm2-measure-pcr=yes,x-systemd.device-timeout=infinity
