[Unit]
# Enabled by the multi-user.target.wants symlink shipped next to it (nothing runs
# `systemctl enable` on an extension).
Description=Torngat node daemon
Documentation=https://github.com/nelsoon/torngat
# Set up by `torngatd init` or `torngatd join` (node.json is written last).
ConditionPathExists=/var/lib/torngat/node.json
Wants=network-online.target
After=network-online.target systemd-sysext.service

[Service]
ExecStart=/usr/bin/torngatd run
Restart=on-failure
RestartSec=2s
# Instances run in units of their own (torngat-vm-<uid>.service): stopping or restarting the daemon
# (an update, a crash) does not touch them.
# It holds keys.
LimitCORE=0
ProtectSystem=full
# LVM keeps copies of the volume groups' metadata there; the rest of /etc/lvm (its configuration
# and devices file, which root tools outside this sandbox follow) stays read-only.
ExecStartPre=+/usr/bin/install -d -m 0700 /etc/lvm/backup /etc/lvm/archive
# "-": they may not exist yet when the line above runs.
ReadWritePaths=-/etc/lvm/backup -/etc/lvm/archive
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

