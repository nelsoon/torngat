[Unit]
# Enabled by the multi-user.target.wants symlink shipped next to it (nothing runs
# `systemctl enable` on an extension).
Description=Torngat node daemon
Documentation=https://github.com/nelsoon/torngat
# Set up by `torngatd init` or `torngatd join` (node.json is written last).
ConditionPathExists=/var/lib/torngat/node.json
Wants=network-online.target
After=network-online.target systemd-sysext.service

[Service]
# systemd-sysusers.service ran before the extension was merged (and only after an OS update),
# so create the QEMU account here. "+": outside the sandbox below (writes /etc/passwd).
ExecStartPre=+/usr/bin/systemd-sysusers torngat.conf
ExecStart=/usr/bin/torngatd run --qemu-user torngat-qemu
Restart=on-failure
RestartSec=2s
# Instances are QEMU processes in their own session: stopping or restarting the daemon (an update,
# a crash) must not kill them. The agent finds them again on start.
KillMode=process
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

